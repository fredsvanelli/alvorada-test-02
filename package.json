{
  "name": "alvorada-bookings",
  "private": true,
  "workspaces": [
    "api",
    "config",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "runbooks": "npm run runbooks:ui",
    "runbooks:ui": "node docs/runbooks/runbooks-ui.mjs",
    "runbooks:upstream": "node web/e2e/runbooks-upstream.mjs",
    "test:e2e": "npm run test:e2e -w web --",
    "test:e2e:headed": "npm run test:e2e -- --headed"
  }
}
